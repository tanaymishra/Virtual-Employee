[Unit]
Description=Superset virtual employee orchestrator
After=network.target

[Service]
Type=simple
User=superset
WorkingDirectory=/home/superset/Virtual-Employee/superset
EnvironmentFile=/home/superset/Virtual-Employee/superset/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
