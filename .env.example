# --- WhatsApp Cloud API (Meta for Developers) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Any string you choose; must match the "Verify Token" you set on the Meta webhook subscription
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# REQUIRED. App secret from the Meta app dashboard, used to verify X-Hub-Signature-256 on every
# incoming webhook. Without it a forged request could impersonate an allow-listed number and
# inject tasks, so the service refuses to start if it's missing.
WHATSAPP_APP_SECRET=

# Comma-separated E.164-style digits (no "+"), e.g. 919876543210,919812345678
# Anyone messaging from a number NOT in this list is silently ignored (no reply at all).
ALLOWED_SENDER_NUMBERS=

# --- GitHub ---
# The server should already be `gh auth login`'d as the dedicated bot account.
# Only set this if you want to force a specific token instead of the gh CLI's stored auth.
GITHUB_TOKEN=

# --- Claude Code ---
CLAUDE_BIN=claude
# Max wall-clock time (ms) for a single task before it's killed and a timeout is reported
CLAUDE_TASK_TIMEOUT_MS=1800000

# --- Server ---
PORT=3000
LOG_FILE=./data/virtual-employee.log
STATE_FILE=./data/state.json
PROJECTS_FILE=./config/projects.json
